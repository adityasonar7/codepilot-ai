# ═══════════════════════════════════════════════════════════════════
# CodePilot AI - Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────
APP_NAME=CodePilot AI
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://codepilot:codepilot@postgres:5432/codepilot_db

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ──────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── GitHub OAuth ─────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github

# ── Gemini AI ────────────────────────────────────────────────────
# Get your API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── OpenAI (Optional Fallback) ──────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Cloudinary (Free Cloud Storage) ─────────────────────────────
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Celery ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Sentry (Optional) ───────────────────────────────────────────
SENTRY_DSN=

# ── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_CLIENT_ID=
